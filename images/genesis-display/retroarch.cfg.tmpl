# Genesis RetroArch template. ${...} values are filled by the container entrypoint (envsubst).
video_driver = "gl"
video_context_driver = "kms"
video_fullscreen = "true"
audio_driver = "${AUDIO_DRIVER}"
audio_device = "${AUDIO_DEVICE}"
input_driver = "udev"
joypad_autoconfig_dir = "/opt/autoconfig"
input_autodetect_enable = "true"
network_cmd_enable = "true"
network_cmd_port = "55355"
savefile_directory = "/data/saves"
savestate_directory = "/data/states"
system_directory = "/data/bios"
libretro_directory = "/cores"
savestate_auto_save = "true"
savestate_auto_load = "true"
# Start+Select held quits (value 4); keyboard fallbacks keep their RetroArch defaults (F2 save, F4 load, Esc quit).
input_quit_gamepad_combo = "4"
input_menu_toggle_gamepad_combo = "0"
quit_press_twice = "false"
config_save_on_exit = "false"
